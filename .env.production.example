APP_NAME="مظلات وسواتر الرياض"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://test-node.nicebox-sa.com/booking
ASSET_URL=https://test-node.nicebox-sa.com/booking
APP_TIMEZONE=Asia/Riyadh
TRUSTED_PROXIES=

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/booking
SESSION_DOMAIN=test-node.nicebox-sa.com

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
SERVICE_IMAGES_ZIP=storage/app/assets.zip

MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_NAME="مدير الموقع"
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
